# Copy to backend/.env and fill in. Never commit the real .env.

# --- Hindsight Cloud -------------------------------------------------------
# Bearer token from https://ui.hindsight.vectorize.io (starts with hsk_).
HINDSIGHT_API_KEY=""
HINDSIGHT_BASE_URL="https://api.hindsight.vectorize.io"

# The memory bank holding all client history. Auto-created on first write.
HINDSIGHT_BANK_ID="clientsense"

# Per-request timeout in seconds.
HINDSIGHT_TIMEOUT=120

# --- Application -----------------------------------------------------------
APP_NAME=ClientSense
DEBUG=True
CORS_ORIGINS="http://localhost:8000,http://127.0.0.1:8000,http://localhost:5500,http://127.0.0.1:5500"

# No LLM key is needed. Hindsight runs fact extraction and reasoning
# server-side with its own configured provider.
